---
search:
  boost: {% if element.deprecated %}0.5{% else %}10.0{% endif %}
---

{%- if element.title %}
    {%- set title = element.title ~ ' (' ~ element.name ~ ')' -%}
{%- else %}
    {%- if gen.use_class_uris -%}
        {%- set title = element.name -%}
    {%- else -%}
        {%- set title = gen.name(element) -%}
    {%- endif -%}
{%- endif -%}

{% macro compute_range(slot) -%}
    {%- if slot.any_of or slot.exactly_one_of -%}
        {%- for subslot_range in schemaview.slot_range_as_union(slot) -%}
            {{ gen.link(subslot_range) }}
            {%- if not loop.last -%}
                &nbsp;or&nbsp;<br />
            {%- endif -%}
        {%- endfor -%}
    {%- else -%}
        {{ gen.link(slot.range) }}
    {%- endif -%}
    {%- if slot.annotations and "foreign_key" in slot.annotations and slot.annotations["foreign_key"].value -%}
        {%- set fk_val = slot.annotations["foreign_key"].value|string -%}
        {%- set fk_cls_name = fk_val.split('.')[0] -%}
        {%- set fk_col_name = fk_val.split('.')[1] if '.' in fk_val else '' -%}
        {%- set fk_elem = schemaview.get_element(fk_cls_name) -%}
        {%- if fk_elem is not none -%}
            <br/>FK &rarr; {{ gen.link(fk_elem) }}{% if fk_col_name %}.`{{ fk_col_name }}`{% endif %}
        {%- endif -%}
    {%- endif -%}
{% endmacro %}

# Class: {{ title }} {% if element.deprecated %} <span style="color: red;"><strong> (DEPRECATED) </strong></span> {% endif %}

{%- if header -%}
{{ header }}
{%- endif -%}

