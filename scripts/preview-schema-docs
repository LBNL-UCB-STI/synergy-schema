#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
schema_path="$repo_root/src/synergy_schema/schema/synergy_schema.yaml"
deliverable_1_schema_path="$repo_root/src/synergy_schema/schema/deliverable_1_static_schema.yaml"
observed_examples_schema_path="$repo_root/src/synergy_schema/schema/observed_examples.yaml"
generated_docs="$repo_root/docs/schema"
observed_examples_docs="$generated_docs/observed-examples"
mode="${1:-serve}"
dev_addr="${ZENSICAL_DEV_ADDR:-127.0.0.1:8000}"

case "$mode" in
  serve | build) ;;
  *)
    echo "Usage: scripts/preview-schema-docs [serve|build]" >&2
    exit 2
    ;;
esac

if [[ "$generated_docs" != "$repo_root/docs/schema" ]]; then
  echo "Refusing to clean unexpected documentation path: $generated_docs" >&2
  exit 1
fi

rm -rf "$generated_docs"
mkdir -p "$generated_docs"
mkdir -p "$observed_examples_docs"

cd "$repo_root"
uv run gen-doc \
  --render-imports \
  --directory "$generated_docs" \
  "$deliverable_1_schema_path"

uv run gen-doc \
  --no-render-imports \
  --directory "$generated_docs" \
  "$schema_path"

uv run gen-doc \
  --no-render-imports \
  --directory "$observed_examples_docs" \
  "$observed_examples_schema_path"

uv run python -m synergy_schema.core_schema_diagram \
  "$repo_root/src/synergy_schema/schema/core" \
  "$generated_docs/core-schema-uml.md"

uv run python -m synergy_schema.deliverable_1_diagram \
  --output "$repo_root/docs/cross-model-mappings/deliverable_1_uml.md"

uv run python -m synergy_schema.mermaid_diagram

uv run python -m synergy_schema.interactive_diagram

cp "$repo_root/examples/one_year_mapping_handshake/review/contract-at-a-glance.md" \
  "$generated_docs/contract-at-a-glance.md"

if [[ "$mode" == "build" ]]; then
  uv run zensical build
else
  echo "Open http://$dev_addr/ to view the schema documentation."
  uv run zensical serve --dev-addr "$dev_addr"
fi
